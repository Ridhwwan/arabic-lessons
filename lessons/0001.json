          "ar": "أَنَا مِنْ نَيْجِيرِيَا.",
          "en": "I'm from Nigeria.",
          "who": "ب"
        },
        {
          "ar": "فُرْصَةٌ سَعِيدَةٌ!",
          "en": "Nice to meet you!",
          "who": "أ"
